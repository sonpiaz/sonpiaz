{
  "name": "sonpiaz-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run generate:contributions && astro build",
    "preview": "astro preview",
    "generate:contributions": "node scripts/github-contributions.mjs",
    "update:contributions-snapshot": "node scripts/github-contributions.mjs --update-snapshot",
    "check:agent-surface": "node scripts/check-agent-surface.mjs",
    "test:agent-surface": "node scripts/test-agent-surface.mjs",
    "check:site-details": "node scripts/check-site-details.mjs",
    "test:site-details": "node scripts/test-site-details.mjs",
    "verify:agent-surface": "npm run build && npm run check:agent-surface && npm run test:agent-surface",
    "verify:site": "npm run build && npm run check:agent-surface && npm run check:site-details && npm run test:agent-surface && npm run test:site-details"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.0",
    "astro": "^5.0.0",
    "posthog-js": "^1.424.0"
  }
}
