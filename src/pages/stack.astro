---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { compareStackEntries, stackUrl } from '../lib/stack';

const stack = (await getEntry('pages', 'stack'))!;
const { Content } = await render(stack);
const tools = (await getCollection('stack')).sort(compareStackEntries);
const jsonLd = [{
  '@type': 'ItemList',
  itemListElement: tools.map((tool, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: tool.data.name,
    description: tool.data.description,
    url: stackUrl(tool),
  })),
}];
---

<Layout title={stack.data.title} description={stack.data.description} jsonLd={jsonLd}>
  <article class="prose">
    <h1>{stack.data.title}</h1>
    <p>{stack.data.description}</p>
    <div class="stack-table" role="table" aria-label="Tools I use">
      <div class="stack-row stack-head" role="row">
        <span role="columnheader">Name</span>
        <span role="columnheader">Description</span>
      </div>
      {tools.map(tool => (
        <div class="stack-row" role="row">
          <span class="stack-name" role="cell">
            {tool.data.logo && <img class:list={['stack-logo', { monochrome: ['github', 'vercel'].includes(tool.data.slug) }]} src={tool.data.logo} width="24" height="24" alt="" />}
            <a href={stackUrl(tool)}>{tool.data.name}</a>
          </span>
          <span role="cell">{tool.data.description}</span>
        </div>
      ))}
    </div>
    <Content />
  </article>
</Layout>
