---
import Base from "../layouts/Base.astro";
---

<Base>
  <header>
    <h1>Son Piaz</h1>
  </header>

  <section class="intro">
    <p>
      I build AI-native tools for affiliate marketing. Currently working on
      <a href="https://affitor.com">Affitor</a> - a platform that helps SaaS
      companies launch, manage, and scale their affiliate programs with AI.
    </p>
    <p>
      I believe the best software will be built by humans and AI working
      together. Most of my work is open source.
    </p>
  </section>

  <section>
    <h2>Projects</h2>
    <ul>
      <li>
        <a href="https://affitor.com">Affitor</a> - AI-native affiliate
        marketing platform for SaaS
      </li>
      <li>
        <a href="https://github.com/Affitor/affiliate-skills">affiliate-skills</a>
        - 45+ open-source AI agent skills for affiliate marketers
      </li>
    </ul>
  </section>

  <section>
    <h2>Social</h2>
    <ul>
      <li><a href="https://x.com/sonxpiaz">X</a></li>
      <li><a href="https://github.com/sonpiaz">GitHub</a></li>
      <li><a href="https://linkedin.com/in/sonpiaz">LinkedIn</a></li>
    </ul>
  </section>

  <section>
    <h2>Thinking</h2>
    <ul>
      <li><a href="/blog">Blog</a> - coming soon</li>
    </ul>
  </section>
</Base>

<style>
  header {
    margin-bottom: 48px;
  }

  h1 {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .intro {
    margin-bottom: 48px;
  }

  .intro p {
    margin-bottom: 16px;
    color: #444;
  }

  section {
    margin-bottom: 40px;
  }

  h2 {
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #999;
    margin-bottom: 12px;
  }

  ul {
    list-style: none;
    padding: 0;
  }

  li {
    margin-bottom: 8px;
  }

  li a:first-child {
    font-weight: 500;
  }
</style>
