---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectList from '../components/ProjectList.astro';
import WritingList from '../components/WritingList.astro';
import Heading from '../components/Heading.astro';
import { person, site, monthYear } from '../lib/site';

const home = (await getEntry('pages', 'home'))!;
const { Content } = await render(home);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const posts = await getCollection('posts');
const main = projects.filter(({ data }) => data.tier === 'main');
const side = projects.filter(({ data }) => data.tier === 'side' && data.featured);
const jsonLd = [
  { ...person, sameAs: home.data.intro_links.map(link => link.href), knowsAbout: main.map(({ data }) => data.name) },
  { '@type': 'WebSite', '@id': `${site}/#website`, name: 'Son Piaz', url: `${site}/`, description: home.data.headline, author: { '@id': person['@id'] } },
];
---

<Layout jsonLd={jsonLd}>
  <h1>{home.data.headline}</h1>
  <div class="prose"><Content /></div>
  <p class="intro-links">
    {home.data.intro_links.map((link, index) => <>{index > 0 && ' · '}<a href={link.href}>{link.label}</a></>)}
  </p>
  <section aria-labelledby="products">
    <Heading class="section-label" text="Products" />
    <ProjectList projects={main} />
  </section>
  <section aria-labelledby="side-projects">
    <Heading class="section-label" text="Side projects" />
    <ProjectList projects={side} />
  </section>
  <p><a href="/projects">All projects</a></p>
  <section aria-labelledby="writing">
    <Heading class="section-label" text="Writing" />
    <WritingList posts={posts} />
  </section>
  <section aria-labelledby="timeline">
    <Heading class="section-label" text="Timeline" />
    <ul class="timeline">
      {home.data.timeline.map(item => (
        <li><time class="meta" datetime={item.date}>{monthYear.format(new Date(`${item.date}-01T00:00:00Z`))}</time><p><a href={item.href}>{item.text}</a></p></li>
      ))}
    </ul>
  </section>
</Layout>
