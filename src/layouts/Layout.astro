---
import { getEntry } from 'astro:content';
import { site, firstParagraph, entityId } from '../lib/site';
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  articleDate?: string;
  jsonLd?: Record<string, unknown>[];
}

const home = (await getEntry('pages', 'home'))!;
const { title = home.data.headline, description = firstParagraph(home.body), noindex = false, articleDate, jsonLd = [] } = Astro.props;
const pageTitle = `${title} | Son Piaz`;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(pathname, site).href;
const markdown = pathname === '/' ? '/index.md' : `${pathname}.md`;
const nav = [ ['Writing', '/writing'], ['Projects', '/projects'], ['Stack', '/stack'], ['About', '/about'] ];
const id = entityId(pathname);
const structured = [...jsonLd];
if (!structured.some(item => item['@id'] === id)) structured.push({ '@type': 'WebPage', '@id': id, url: canonical, name: title });
if (pathname !== '/') {
  const parent = pathname.startsWith('/projects/') ? ['Projects', '/projects'] : pathname.startsWith('/writing/') ? ['Writing', '/writing'] : undefined;
  const crumbs = [['Home', '/'], ...(parent ? [parent] : []), [title!, pathname]];
  structured.push({
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map(([name, path], index) => ({ '@type': 'ListItem', position: index + 1, name, item: new URL(path, site).href })),
  });
}
const linkedData = JSON.stringify({ '@context': 'https://schema.org', '@graph': structured }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Son Piaz Writing" href="/rss.xml" />
    {!noindex && <link rel="alternate" type="text/markdown" href={new URL(markdown, site)} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={articleDate ? 'article' : 'website'} />
    <meta property="og:image" content={new URL('/og.png', site)} />
    {articleDate && <meta property="article:published_time" content={articleDate} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@sonxpiaz" />
    <script type="application/ld+json" set:html={linkedData} />
    {noindex && <meta name="robots" content="noindex" />}
    <Analytics />
  </head>
  <body id="top">
    <div class="shell">
      <header class="site-header">
        <a class="site-name" href="/">Son Piaz</a>
        <nav aria-label="Main navigation">
          {nav.map(([label, href]) => (
            <a href={href} aria-current={pathname === href || pathname.startsWith(`${href}/`) ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </header>
      <main id="entity" data-entity-id={id}><slot /></main>
      <footer class="site-footer"><span>Son Piaz</span> · <a href="https://x.com/sonxpiaz">@sonxpiaz</a> · <a href="https://github.com/sonpiaz">GitHub</a><a class="back-to-top" href="#top">Back to top ↑</a></footer>
    </div>
  </body>
</html>
