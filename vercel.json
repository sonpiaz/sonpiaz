{
  "headers": [
    {
      "source": "/:path*.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/blog",
      "destination": "/writing",
      "permanent": true
    }
  ]
}
